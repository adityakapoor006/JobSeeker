OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Lower-cost model for fit scoring, email and company checks.
OPENAI_CHEAP_MODEL=gpt-4.1-mini
APIFY_TOKEN=
# Inbox updates (optional). For Gmail, create an app password; IMAP host defaults to imap.gmail.com.
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
EMAIL_IMAP_HOST=imap.gmail.com
# Claude (optional): key from console.anthropic.com. Used when OpenAI fails or runs out of credit.
ANTHROPIC_API_KEY=
# Order to try providers in; put anthropic first to prefer Claude.
LLM_PROVIDERS=openai,anthropic
